        "inaccessible_refs": [
          "secret"
        ]
      }
    },
    {
      "id": "grant_tag_boundary",
      "group": "contract",
      "task": "A query cannot widen the grant to another tag.",
      "records": [
        {
          "id": "secret",
          "text": "Review completed.",
          "tags": [
            "finance"
          ]
        },
        {
          "id": "answer",
