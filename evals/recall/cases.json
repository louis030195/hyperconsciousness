        ]
      }
    },
    {
      "id": "private_replacement",
      "group": "contract",
      "task": "A private correction must suppress the public old version.",
      "records": [
        {
          "id": "old",
          "text": "Deployment host: cedar.",
          "source": "host",
          "version": 1
        },
        {
          "id": "secret",
          "text": "Deployment host: birch.",
