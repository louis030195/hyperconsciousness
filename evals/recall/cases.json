      "limit": 3,
      "expect": {
        "ids": [
          "answer"
        ],
        "denied": false,
        "inaccessible_refs": [
          "old"
        ],
        "by_path": {
          "snapshot": {
            "ids": [],
            "denied": true,
            "inaccessible_refs": [
              "old",
              "answer"
            ]
          },
          "indexed": {
            "ids": [],
            "denied": true,
            "inaccessible_refs": [
              "old",
              "answer"
            ]
          }
        }
      }
    },
