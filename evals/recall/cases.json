{
  "schema": 1,
  "description": "Synthetic, finite HC retrieval evals. No models, scheduling, or runtime agent loops.",
  "cases": [
    {
      "id": "literal_recall",
      "group": "contract",
      "task": "Find the recorded project code.",
      "records": [
        {
          "id": "answer",
          "text": "Project code: ORCHID-42."
        },
        {
          "id": "noise",
          "text": "Bring an umbrella."
        }
      ],
      "query": "ORCHID-42",
      "limit": 3,
      "expect": {
        "ids": [
          "answer"
        ],
        "denied": false
      }
    },
    {
