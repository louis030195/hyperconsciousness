        {
          "id": "answer",
          "text": "Session completed.",
          "tags": [
            "fitness"
          ]
        },
        {
          "id": "noise",
          "text": "Session completed.",
          "tags": [
            "work"
          ]
        }
      ],
      "query": "Session",
      "limit": 3,
      "expect": {
        "ids": [
          "answer"
        ],
        "denied": false
      },
      "tags": [
        "fitness"
      ]
    },
    {
      "id": "date_filter",
      "group": "contract",
      "task": "Return only evidence ingested during the requested interval.",
      "records": [
        {
          "id": "old",
          "text": "Session completed.",
          "at": 1000
        },
        {
          "id": "answer",
          "text": "Session completed.",
          "at": 2000
        },
        {
          "id": "new",
          "text": "Session completed.",
          "at": 3000
        }
      ],
      "query": "Session",
      "limit": 3,
      "expect": {
        "ids": [
          "answer"
        ],
        "denied": false
      },
      "since": 2000,
      "until": 3000
    },
    {
      "id": "correction",
      "group": "contract",
      "task": "Use the explicitly corrected host, not the old version.",
      "records": [
        {
          "id": "old",
          "text": "Deployment host: cedar.",
          "source": "host",
          "version": 1
        },
        {
          "id": "answer",
          "text": "Deployment host: birch.",
          "source": "host",
          "version": 2
        }
      ],
      "query": "Deployment host",
      "limit": 3,
      "expect": {
        "ids": [
          "answer"
        ],
        "denied": false,
        "inaccessible_refs": [
          "old"
        ]
      }
    },
    {
      "id": "old_wording",
      "group": "contract",
      "task": "Searching old wording must not resurrect a corrected record.",
      "records": [
        {
          "id": "old",
          "text": "Deployment host: cedar.",
          "source": "host",
          "version": 1
        },
        {
          "id": "answer",
          "text": "Deployment host: birch.",
          "source": "host",
          "version": 2
        }
      ],
      "query": "cedar",
      "limit": 3,
      "expect": {
        "ids": [],
        "denied": false,
        "inaccessible_refs": [
          "old"
        ]
      }
    },
    {
      "id": "retraction",
      "group": "contract",
      "task": "Retracted evidence must not be returned or dereferenced.",
      "records": [
        {
          "id": "old",
          "text": "The launch is Tuesday.",
          "source": "launch",
          "version": 1
        },
        {
          "id": "tombstone",
          "text": "",
